# ──────────────────────────────────────────────────────────────
# ClipHive — environment variables
#
# Only secrets and per-installation configuration live here.
# Anything that is not secret and can change at runtime lives in
# the superadmin settings instead (the `setting` table).
# See docs/DESIGN.md section 13 for the full security model.
# ──────────────────────────────────────────────────────────────

# ──────────────────────────────────────────────
# PostgreSQL database
# ──────────────────────────────────────────────
CLIPHIVE_DB_URL=jdbc:postgresql://localhost:5432/cliphive
CLIPHIVE_DB_USER=cliphive
CLIPHIVE_DB_PASSWORD=

# ──────────────────────────────────────────────
# Data directory (jobs/<id>/source, audio, chunks, clips — put it on an SSD)
# ──────────────────────────────────────────────
CLIPHIVE_DATA_DIR=

# ──────────────────────────────────────────────
# Superadmin — single account, created on first boot
# ──────────────────────────────────────────────
CLIPHIVE_ADMIN_USER=
CLIPHIVE_ADMIN_PASSWORD=

# ──────────────────────────────────────────────
# Encryption keys
# CLIPHIVE_ENCRYPTION_KEY encrypts OAuth tokens and the TOTP secret in the DB.
# CLIPHIVE_URL_SIGNING_KEY signs the short-lived worker and /media file URLs.
# ──────────────────────────────────────────────
CLIPHIVE_ENCRYPTION_KEY=
CLIPHIVE_URL_SIGNING_KEY=

# ──────────────────────────────────────────────
# Network — three separate listeners (see docs/DESIGN.md section 3.2)
# ──────────────────────────────────────────────
# Superadmin — binds to localhost only, published via Cloudflare Tunnel + Access
CLIPHIVE_ADMIN_PORT=8080
# Public URL of the superadmin — OAuth redirect URIs are built from it
# (<url>/admin/accounts/<platform>/callback), register them in each platform
# e.g. https://cliphive.example.com
CLIPHIVE_ADMIN_PUBLIC_URL=

# Who runs this installation — named as data controller and contact on the
# public /legal/privacy and /legal/terms pages that Google, Meta and TikTok review
# e.g. Your Name
CLIPHIVE_OPERATOR_NAME=
# e.g. you@example.com
CLIPHIVE_OPERATOR_EMAIL=

# Public media route for Instagram — binds to localhost, only serves GET /media/{token}
CLIPHIVE_MEDIA_PORT=8081
# e.g. https://cliphive-media.example.com
CLIPHIVE_MEDIA_PUBLIC_URL=

# Worker coordination — binds to the Tailscale interface only
CLIPHIVE_WORKER_BIND=
CLIPHIVE_WORKER_PORT=8082

# ──────────────────────────────────────────────
# TikTok — Content Posting API (developers.tiktok.com). Use the sandbox keys
# until the app is reviewed (docs/DEPLOY.md section 15).
# ──────────────────────────────────────────────
CLIPHIVE_TIKTOK_CLIENT_KEY=
CLIPHIVE_TIKTOK_CLIENT_SECRET=

# ──────────────────────────────────────────────
# Instagram — Meta app with "API with Instagram login" (developers.facebook.com)
# ──────────────────────────────────────────────
CLIPHIVE_META_APP_ID=
CLIPHIVE_META_APP_SECRET=

# ──────────────────────────────────────────────
# YouTube — Google Cloud project with Data API v3 (console.cloud.google.com)
# ──────────────────────────────────────────────
CLIPHIVE_GOOGLE_CLIENT_ID=
CLIPHIVE_GOOGLE_CLIENT_SECRET=

# ──────────────────────────────────────────────
# SMTP — low-queue email alerts (section 12.3). Empty host = alerts off.
# Resend: host smtp.resend.com, user "resend", password = a Resend API key,
# and a FROM on a domain verified in Resend. Port 465 switches to implicit SSL.
# ──────────────────────────────────────────────
# e.g. smtp.resend.com
CLIPHIVE_SMTP_HOST=
CLIPHIVE_SMTP_PORT=587
# e.g. resend
CLIPHIVE_SMTP_USER=
CLIPHIVE_SMTP_PASSWORD=
# e.g. ClipHive <cliphive@your-verified-domain.com>
CLIPHIVE_SMTP_FROM=

# ──────────────────────────────────────────────
# Claude — content analysis, titles/descriptions and the publication scheduler
# Use CLAUDE_CODE_OAUTH_TOKEN when running `claude -p` as a service
# (generate it with `claude setup-token`). ANTHROPIC_API_KEY is only needed
# if the Anthropic API is used instead of `claude -p`.
# ──────────────────────────────────────────────
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# ──────────────────────────────────────────────
# External tool paths — optional, only set if not already on PATH
# (autodetected otherwise; add .exe on Windows)
# ──────────────────────────────────────────────
CLIPHIVE_YTDLP_PATH=
CLIPHIVE_FFMPEG_PATH=
CLIPHIVE_FFPROBE_PATH=
CLIPHIVE_CLAUDE_PATH=

# ──────────────────────────────────────────────
# Docker Compose only (docs/DEPLOY.md section 0) — the server ignores these
# ──────────────────────────────────────────────
# Image tag of ghcr.io/raulgl422/cliphive-server to run (default: latest), e.g. 0.1.0
# CLIPHIVE_VERSION=
# Host folder mounted as /data (default: ./data)
# CLIPHIVE_DATA_HOST_DIR=
# JVM options (default: -Xms128m -Xmx512m)
# CLIPHIVE_JAVA_OPTS=
