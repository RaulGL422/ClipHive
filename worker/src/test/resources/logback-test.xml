<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests log to the console only — the main logback.xml would also write to
     the real worker.log in the user's data directory. -->
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="io.github.raulgl422.cliphive" level="DEBUG"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
